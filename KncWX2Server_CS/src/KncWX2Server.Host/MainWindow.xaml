<Window x:Class="KncWX2Server.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KncWX2Server (.NET 11) - Multi-Region Full Server Suite Host"
        Width="1160" Height="740"
        Background="#1A202C" Foreground="#EDF2F7"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Controls -->
        <Border Grid.Row="0" Background="#2D3748" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Region:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                <ComboBox x:Name="RegionCombo" Width="160" Margin="0,0,12,0" SelectionChanged="RegionCombo_SelectionChanged" />

                <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="PortTextBox" Text="9400" Width="65" Margin="0,0,12,0" VerticalContentAlignment="Center" />

                <TextBlock Text="GroupID:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="GroupIdTextBox" Text="0" Width="45" Margin="0,0,12,0" VerticalContentAlignment="Center" />

                <Button x:Name="StartButton" Content="Start Server" Background="#2F855A" Click="StartButton_Click" />
                <Button x:Name="StopButton" Content="Stop Server" Background="#C53030" IsEnabled="False" Click="StopButton_Click" />

                <Border x:Name="StatusBadge" Background="#742A2A" CornerRadius="4" Padding="8,4" Margin="12,0,0,0">
                    <TextBlock x:Name="StatusText" Text="STOPPED" FontWeight="Bold" Foreground="White" />
                </Border>
            </WrapPanel>
        </Border>

        <!-- Lua Config Bar -->
        <Border Grid.Row="1" Background="#2D3748" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lua Config:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="LuaPathTextBox" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Browse..." Click="BrowseLua_Click" />
                <Button Grid.Column="3" Content="Execute Lua File" Click="ExecLuaFile_Click" />
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="2" Background="#1A202C" Foreground="#EDF2F7" BorderBrush="#4A5568">
            <TabItem Header="Live Logs &amp; Lua Console">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Log Level:" Foreground="#EDF2F7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="LogLevelCombo" Width="140" Margin="0,0,12,0" SelectionChanged="LogLevelCombo_SelectionChanged" />
                        <Button Content="Clear Logs" Click="ClearLogs_Click" />
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="LogListBox"
                             Background="#0D1117" Foreground="#E2E8F0"
                             FontFamily="Consolas" FontSize="12"
                             BorderBrush="#4A5568" />

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lua&gt;" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#68D391" />
                        <TextBox Grid.Column="1" x:Name="LuaCmdTextBox" FontFamily="Consolas" VerticalContentAlignment="Center" KeyDown="LuaCmdTextBox_KeyDown" />
                        <Button Grid.Column="2" Content="Eval" Click="EvalLua_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Sessions &amp; Channels">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Connected Users" Foreground="#EDF2F7" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Refresh" Click="RefreshMonitor_Click" />
                            <Button Content="Kick Selected" Click="KickSelected_Click" />
                        </StackPanel>
                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#0D1117" Foreground="#E2E8F0" RowBackground="#1A202C" AlternatingRowBackground="#2D3748">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="110" />
                                <DataGridTextColumn Header="UserID" Binding="{Binding UserId}" Width="110" />
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="110" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Active Region Channels" Foreground="#EDF2F7" FontWeight="Bold" Margin="0,0,0,10" />
                        <DataGrid x:Name="ChannelsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#0D1117" Foreground="#E2E8F0" RowBackground="#1A202C" AlternatingRowBackground="#2D3748">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ChannelId}" Width="60" />
                                <DataGridTextColumn Header="Channel Name" Binding="{Binding ChannelName}" Width="180" />
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="105" />
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="65" />
                                <DataGridTextColumn Header="Users" Binding="{Binding Users}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="SQLite Accounts &amp; WaitQueue">
                <StackPanel Margin="10">
                    <GroupBox Header="Provision SQLite Account" Foreground="#EDF2F7" Padding="10" Margin="0,0,0,12">
                        <WrapPanel>
                            <TextBlock Text="UserID:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="NewUserIdBox" Width="130" Margin="0,0,12,0" />
                            <TextBlock Text="Password:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="NewPasswordBox" Width="130" Margin="0,0,12,0" />
                            <TextBlock Text="AuthLevel:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="NewAuthLevelBox" Text="0" Width="50" Margin="0,0,12,0" />
                            <Button Content="Create Account" Click="CreateAccount_Click" />
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="WaitQueue Controls" Foreground="#EDF2F7" Padding="10">
                        <WrapPanel>
                            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="WaitQueueModeCombo" Width="160" Margin="0,0,12,0" />
                            <TextBlock Text="Max CCU:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="WaitQueueLimitBox" Text="100000" Width="80" Margin="0,0,12,0" />
                            <Button Content="Apply WaitQueue" Click="ApplyWaitQueue_Click" />
                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Suite Topology &amp; Relay Monitor">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Top" Text="Active Servers &amp; Relay Endpoints" Foreground="#EDF2F7" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid x:Name="SuiteGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#0D1117" Foreground="#E2E8F0" RowBackground="#1A202C" AlternatingRowBackground="#2D3748">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="180" />
                                <DataGridTextColumn Header="Protocol / Port" Binding="{Binding Endpoint}" Width="160" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Live Metrics" Binding="{Binding Metrics}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Text="Active Rooms &amp; UDP Relay Peers" Foreground="#EDF2F7" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid x:Name="RoomsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#0D1117" Foreground="#E2E8F0" RowBackground="#1A202C" AlternatingRowBackground="#2D3748">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RoomUID" Binding="{Binding RoomUid}" Width="110" />
                                <DataGridTextColumn Header="Name" Binding="{Binding RoomName}" Width="200" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                                <DataGridTextColumn Header="Slots" Binding="{Binding Slots}" Width="80" />
                                <DataGridTextColumn Header="UDP Relay" Binding="{Binding UdpRelay}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Status Bar -->
        <StatusBar Grid.Row="3" Background="#2D3748" Foreground="#CBD5E0" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="FooterSummary" Text="UID: 0 | Region: TW | Connected: 0 | Tick: 0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
